############################################
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in values. NEVER commit terraform.tfvars
# (it is already excluded via .gitignore). Do not put secrets in this file
# either - use environment variables (TF_VAR_*) for admin_password and any
# service principal secret.
############################################

subscription_id = "00000000-0000-0000-0000-000000000000" # az account show --query id -o tsv
tenant_id       = "00000000-0000-0000-0000-000000000000" # az account show --query tenantId -o tsv

workload_name = "ws16arc"
environment   = "demo"
location      = "swedencentral" # do not change without re-verifying image availability
instance      = "01"

owner                   = "your-name-or-team"
intended_deletion_date  = "2026-09-30" # YYYY-MM-DD, informational tag only

# admin_password: DO NOT set here. Supply via:
#   export TF_VAR_admin_password='a-strong-password-here'
admin_username = "azdemoadmin"

default_vm_size               = "Standard_B2s_v2"
os_disk_storage_account_type  = "Standard_LRS"
enable_azure_hybrid_benefit   = false

default_auto_shutdown_enabled = true
default_auto_shutdown_time    = "1900"
auto_shutdown_timezone        = "W. Europe Standard Time"

# How the three Arc evaluation VMs authenticate onboarding. One of:
#   "service_principal_new"      - Terraform creates the Entra app/SP (needs
#                                  Application Administrator/equivalent).
#   "service_principal_existing" - you supply an already-created SP's IDs
#                                  below (needs no Entra admin role for you).
#   "interactive_user"           - no Entra app/SP at all; Terraform grants
#                                  YOU (or the principal below) the RBAC role,
#                                  and you run azcmagent connect manually via
#                                  RDP/Serial Console. Use this if your tenant
#                                  blocks app/SP creation entirely (e.g.
#                                  `az ad sp create-for-rbac` fails with
#                                  "Insufficient privileges").
arc_onboarding_method = "service_principal_new"

# Only needed if arc_onboarding_method = "service_principal_existing":
# arc_service_principal_client_id = ""   # supply via TF_VAR_arc_service_principal_client_id
# arc_service_principal_secret    = ""   # supply via TF_VAR_arc_service_principal_secret

# Only used if arc_onboarding_method = "interactive_user". Leave empty to
# default to whoever runs `terraform apply`.
# interactive_onboarding_principal_id = ""

# Uncomment and adjust only if you need temporary public RDP access to a
# specific VM for the demo. Never use 0.0.0.0/0 as the trusted CIDR.
# IMPORTANT: this replaces the ENTIRE default vm_configs map - all 5 VMs must
# be listed here, or the missing ones will be destroyed.
# vm_configs = {
#   "arc-vm01" = {
#     management_type         = "arc-evaluation"
#     os_edition              = "windows-server-2016-datacenter"
#     enable_public_ip        = true
#     enable_public_rdp       = true
#     trusted_rdp_source_cidr = "203.0.113.10/32" # replace with YOUR public IP/32
#   }
#   "arc-vm02"    = { management_type = "arc-evaluation", os_edition = "windows-server-2016-datacenter" }
#   "arc-vm03"    = { management_type = "arc-evaluation", os_edition = "windows-server-2016-datacenter" }
#   "native-vm01" = { management_type = "native-azure", os_edition = "windows-server-2016-datacenter" }
#   "native-vm02" = { management_type = "native-azure", os_edition = "windows-server-2016-datacenter" }
# }
